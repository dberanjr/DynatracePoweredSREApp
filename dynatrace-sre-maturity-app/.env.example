# Copy to .env (untracked) and fill in. Read by app.config.ts (dt-app) and
# scripts/sync-version.mjs (generates ui/app/constants.ts) on start/build/deploy.

# Dynatrace environment to deploy to, no trailing slash.
DT_ENVIRONMENT_URL=https://YOUR_TENANT.apps.dynatrace.com

# Customer name shown on the landing page heading and leaderboard subtitle.
COMPANY_NAME=YourCompany

# App name in the manifest; the UI shows it via the app-environment SDK.
APP_NAME=DynatracePoweredSRE
